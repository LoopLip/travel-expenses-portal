# Скопируйте в backend/.env и подставьте свои значения. Файл .env в git не попадает.
# Строка подключения SQLAlchemy (драйвер psycopg 3).
DATABASE_URL=postgresql+psycopg://travel:CHANGE_ME@localhost:5433/travel_expenses

# Разрешённые источники для CORS (через запятую)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Аутентификация (ЛР №4) ---
# Секрет подписи JWT: случайная строка не короче 32 символов. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_TO_RANDOM_STRING_OF_32_OR_MORE_CHARS
# Срок жизни access-токена, минуты (можно дробное: 0.1 = 6 секунд, для проверки истечения)
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Срок жизни refresh-токена, дни
REFRESH_TOKEN_EXPIRE_DAYS=7
# Cookie с refresh-токеном: Secure нужен при HTTPS (в продакшене true), SameSite: lax | strict | none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
